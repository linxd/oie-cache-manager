{
    "schemaVersion": 1,
    "id": "oie-cache-manager",
    "name": "OIE 缓存管理器",
    "description": "为通道提供数据库支持的查询缓存：定义 JDBC 数据源缓存，支持自动刷新和淘汰策略，可通过任意脚本中的 $g(\"name\").lookup(key) 查找值，监控实时命中率统计，检查缓存条目，并按需刷新。同时支持 Swing 和 Web 管理界面。",
    "type": "plugin",
    "ui": [
        "web",
        "swing"
    ],
    "version": "1.2.0",
    "minEngineVersion": "4.6.0",
    "maxEngineVersion": null,
    "filename": "oie-cache-manager-{version}.zip",
    "restartRequired": true,
    "homepage": "https://github.com/diridium-com/oie-cache-manager",
    "documentation": "https://github.com/diridium-com/oie-cache-manager#readme",
    "storeDocs": "docs/store.md",
    "license": "MPL-2.0",
    "authors": [
        "Diridium Technologies Inc."
    ],
    "keywords": [
        "cache",
        "lookup",
        "jdbc",
        "database",
        "performance",
        "reference-data"
    ],
    "deprecated": false
}